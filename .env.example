# Supabase project (public values)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Runtime DB: role app_rls (NOBYPASSRLS) via Supavisor transaction pooler (port 6543)
DATABASE_URL=postgresql://app_rls.<project-ref>:<app_rls-password>@<pooler-host>:6543/postgres

# Migrations only (CI / local scripts, never on Vercel): postgres via session pooler (port 5432)
DATABASE_URL_MIGRATE=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Optional: product name shown in titles, the sign-in screen and email senders (default "Dashboard")
# NEXT_PUBLIC_APP_NAME=Mi Tablero

# Public base URL, used in links inside emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: public demo account (seed: node scripts/seed.ts --yes). Shown on the login page when both are set.
# NEXT_PUBLIC_DEMO_EMAIL=demo@demo.test
# NEXT_PUBLIC_DEMO_PASSWORD=choose-a-password

# Optional: keep the seeded demo admin login fixed across reseeds (put real values in .env.local)
# SEED_ADMIN_EMAIL=admin@demo.test
# SEED_ADMIN_PASSWORD=choose-a-password
